# Ollama (default). Start the server and load the model before generating answers.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11435/v1
LOCAL_LLM_MODEL=qwen2.5:3b

# LM Studio: use http://127.0.0.1:1234/v1 and the loaded model's identifier.
# Set this only when your compatible server requires authentication.
# LOCAL_LLM_API_KEY=

# Optional protection for local refresh endpoint.
# CRON_SECRET=
